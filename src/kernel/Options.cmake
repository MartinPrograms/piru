# Compile time options for the PIRU kernel.
function(piru_append_bool VAR)
    if(${VAR})
        string(APPEND CONFIG_INCLUDES_CONTENT "true")
    else()
        string(APPEND CONFIG_INCLUDES_CONTENT "false")
    endif()
    set(CONFIG_INCLUDES_CONTENT "${CONFIG_INCLUDES_CONTENT}" PARENT_SCOPE)
endfunction()

function(piru_append_bool_option NAME VAR)
    string(APPEND CONFIG_INCLUDES_CONTENT "\n\tinline constexpr bool ${NAME} = ")
    piru_append_bool(${VAR})
    string(APPEND CONFIG_INCLUDES_CONTENT ";\n")
    set(CONFIG_INCLUDES_CONTENT "${CONFIG_INCLUDES_CONTENT}" PARENT_SCOPE)
endfunction()

# Option variables
option(PIRU_RUN_TESTS "Run sub-system self-tests at boot" ON)
option(PIRU_TEST_PAGING_TLB "Run the (slow) TLB control test" ON)
option(PIRU_TEST_SMP "Run the smp (CallOn / CallOnAll / idle loop) tests at boot" ON)
option(PIRU_POISON_PMM "Poison PMM memory (slow, scales with memory size), this adds protection against handing out non-freed pages (in cases of memory corruption, or other spooky stuff)" ON)
set(PIRU_LOG_LEVEL "DEBUG" CACHE STRING "Minimum log level") # see definitions.hpp for valid input

# Header file
set(CONFIG_INCLUDES_CONTENT "// Auto generated by CMake. Do NOT edit. \n\n#ifndef PIRU_AUTOGENERATED_CONFIG_HPP\n#define PIRU_AUTOGENERATED_CONFIG_HPP\n\n#include \"definitions.hpp\"\n\n")
string(APPEND CONFIG_INCLUDES_CONTENT "namespace piru::config {\n")

piru_append_bool_option(RunSubsystemSelfTests PIRU_RUN_TESTS)
piru_append_bool_option(RunTlbControlTest PIRU_TEST_PAGING_TLB)
piru_append_bool_option(RunSmpTests PIRU_TEST_SMP)
piru_append_bool_option(PoisonPMM PIRU_POISON_PMM)

string(APPEND CONFIG_INCLUDES_CONTENT "\n\tinline constexpr piru::core::LogLevel ConsoleLogLevel = piru::core::LogLevel::")
string(APPEND CONFIG_INCLUDES_CONTENT ${PIRU_LOG_LEVEL})
string(APPEND CONFIG_INCLUDES_CONTENT ";\n")

string(APPEND CONFIG_INCLUDES_CONTENT "\n}\n\n#endif")

set(TEMP_HEADER "${CMAKE_CURRENT_BINARY_DIR}/generated_config.hpp.tmp")
set(FINAL_HEADER "${CMAKE_CURRENT_SOURCE_DIR}/piru/config.hpp")

file(WRITE "${TEMP_HEADER}" "${CONFIG_INCLUDES_CONTENT}")
configure_file("${TEMP_HEADER}" "${FINAL_HEADER}" COPYONLY)
