# Subsystems
file(GLOB_RECURSE SUBSYSTEM_HEADERS "${CMAKE_CURRENT_SOURCE_DIR}/piru/subsystems/*.hpp")

set(SUBSYSTEM_INCLUDES_CONTENT "// Auto generated by CMake. Do NOT edit. \n\n#ifndef PIRU_AUTOGENERATED_SUBSYSTEM_HPP\n#define PIRU_AUTOGENERATED_SUBSYSTEM_HPP\n\n")
foreach (HEADER_PATH ${SUBSYSTEM_HEADERS})
    file(RELATIVE_PATH REL_PATH "${CMAKE_CURRENT_SOURCE_DIR}/piru" "${HEADER_PATH}")
    string(APPEND SUBSYSTEM_INCLUDES_CONTENT "#include \"${REL_PATH}\"\n")
endforeach ()
string(APPEND SUBSYSTEM_INCLUDES_CONTENT "\n#endif")

set(TEMP_HEADER "${CMAKE_CURRENT_BINARY_DIR}/generated_subsystems.hpp.tmp")
set(FINAL_HEADER "${CMAKE_CURRENT_SOURCE_DIR}/piru/subsystems.hpp")

file(WRITE "${TEMP_HEADER}" "${SUBSYSTEM_INCLUDES_CONTENT}")
configure_file("${TEMP_HEADER}" "${FINAL_HEADER}" COPYONLY)